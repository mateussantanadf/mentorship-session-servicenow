<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Verify Session date is in past</description>
        <field>session_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>verifySessionDate</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue || newValue.indexOf('-') === -1) {
        return;
    }

    var dataSelecionada = newValue.split(' ')[0];
    var hoje = new Date().toISOString().split('T')[0];

    if (dataSelecionada < hoje) {
        g_form.clearMessages();
        g_form.addErrorMessage('The session date cannot be earlier than today.');
        g_form.clearValue('session_date');
    }
}]]></script>
